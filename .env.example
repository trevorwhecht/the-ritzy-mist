# ---- Required now (Phase 0) ----
# Postgres connection string. Prisma needs this for `migrate` and `db seed`.
DATABASE_URL=
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Seeds the first admin. Both must be set or the seed skips admin creation.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=

# ---- Phase 1: Apple Calendar over CalDAV ----
# App-specific password from appleid.apple.com > Sign-In and Security.
ICLOUD_APPLE_ID=
ICLOUD_APP_PASSWORD=
# Comma-separated calendar names whose events block booking (30 min buffer after each).
ICLOUD_BLOCKING_CALENDARS=
# Calendar that booked appointments are written into. Must NOT appear in the blocking list.
ICLOUD_BOOKING_CALENDAR=

# ---- Phase 2: booking confirmation email ----
SENDGRID_API_KEY=
BOOKING_FROM_EMAIL=
ADMIN_EMAIL_NOTIFICATIONS=

# ---- Phase 5: Stripe subscriptions ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_MEMBERSHIP_PRICE_ID=

# ---- Optional: "Continue with Google" appears only when both are set ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Existing site features ----
BLOB_READ_WRITE_TOKEN=
PRICING_PASSWORD=

# ---- Home page Google reviews and photos (Places API New) ----
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# ---- Optional: every Google review via the Business Profile API (owner OAuth, scope business.manage) ----
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
